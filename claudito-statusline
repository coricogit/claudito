#!/usr/bin/env python3
"""Claude Code status line for Claudito.

Saves the JSON Claude Code passes to the status line (model, context window,
plan rate limits...) to $XDG_RUNTIME_DIR/claudito/statusline.json for the
usage widget, and prints a short status line.
"""
import json
import os
import sys
import tempfile
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
DIR = os.path.join(RUNTIME, "claudito")

try:
    raw = sys.stdin.read()
    data = json.loads(raw)
except ValueError:
    print("Claudito")
    sys.exit(0)

try:
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    data["_saved"] = time.time()
    # Leftovers of status lines that Claude Code stopped halfway.
    for name in os.listdir(DIR):
        if name.startswith(".statusline-"):
            old = os.path.join(DIR, name)
            try:
                if time.time() - os.path.getmtime(old) > 60:
                    os.unlink(old)
            except OSError:
                pass
    # A file of its own: several sessions may be writing at once.
    fd, tmp = tempfile.mkstemp(dir=DIR, prefix=".statusline-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(data, f)
        os.replace(tmp, os.path.join(DIR, "statusline.json"))
    except BaseException:
        os.unlink(tmp)
        raise
except OSError:
    pass

def spanish():
    for var in ("LC_ALL", "LC_TIME", "LANG"):
        if os.environ.get(var):
            return os.environ[var].startswith("es")
    if os.name == "nt":
        try:
            import ctypes
            # Primary language id 0x0a is Spanish (es-ES, es-MX...).
            return ctypes.windll.kernel32.GetUserDefaultUILanguage() & 0x3FF == 0x0A
        except (AttributeError, OSError):
            pass
    return False


DAYS = {True: ("lun", "mar", "mié", "jue", "vie", "sáb", "dom"),
        False: ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun")}


def resets(lim):
    """When a limit window resets, in local time: '02:10', or 'Tue 12:00' if not within a day."""
    at = lim.get("resets_at")
    now = time.time()
    if not isinstance(at, (int, float)) or at <= now:
        return ""
    t = time.localtime(at)
    clock = time.strftime("%H:%M", t)
    if at - now < 86400:
        return f" ({clock})"
    return f" ({DAYS[spanish()][t.tm_wday]} {clock})"


parts = []
model = (data.get("model") or {}).get("display_name")
if model:
    parts.append(model)
ctx = data.get("context_window") or {}
pct = ctx.get("used_percentage")
if isinstance(pct, (int, float)):
    parts.append(f"ctx {pct:.0f}%")
limits = data.get("rate_limits") or {}
for key, label in (("five_hour", "5h"), ("seven_day", "7d")):
    lim = limits.get(key) or {}
    used = lim.get("used_percentage")
    if isinstance(used, (int, float)):
        parts.append(f"{label} {used:.0f}%{resets(lim)}")
print(" · ".join(parts) or "Claudito")
