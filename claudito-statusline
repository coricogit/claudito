#!/usr/bin/env python3
"""Claude Code status line for Claudito.

Saves the JSON Claude Code passes to the status line (model, context window,
plan rate limits...) to $XDG_RUNTIME_DIR/claudito/statusline.json for the
usage widget, and prints a short status line.
"""
import json
import os
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
DIR = os.path.join(RUNTIME, "claudito")

try:
    raw = sys.stdin.read()
    data = json.loads(raw)
except ValueError:
    print("Claudito")
    sys.exit(0)

try:
    os.makedirs(DIR, mode=0o700, exist_ok=True)
    data["_saved"] = time.time()
    tmp = os.path.join(DIR, "statusline.json.tmp")
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, os.path.join(DIR, "statusline.json"))
except OSError:
    pass

parts = []
model = (data.get("model") or {}).get("display_name")
if model:
    parts.append(model)
ctx = data.get("context_window") or {}
pct = ctx.get("used_percentage")
if isinstance(pct, (int, float)):
    parts.append(f"ctx {pct:.0f}%")
limits = data.get("rate_limits") or {}
five = (limits.get("five_hour") or {}).get("used_percentage")
if isinstance(five, (int, float)):
    parts.append(f"5h {five:.0f}%")
week = (limits.get("seven_day") or {}).get("used_percentage")
if isinstance(week, (int, float)):
    parts.append(f"7d {week:.0f}%")
print(" · ".join(parts) or "Claudito")
